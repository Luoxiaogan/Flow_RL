ate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant entities and relationships\n        entity_extraction_instruction = """\n        Identify all entities, relationships, and key facts mentioned in the problem. \n        Focus on entities such as people, places, organizations, and their attributes. \n        Also, note any explicit or implicit connections between these entities. \n        Format the output as a structured list of entities and their relationships.\n        """\n        entities = await self.generate(instruction=entity_extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question type and reasoning chain\n        question_analysis_instruction = f"""\n        Given the extracted entities and relationships: {entities}\n        Analyze the type of question being asked. Determine if it is a bridge question, \n        comparison question, compositional question, or date/time question. \n        Identify the reasoning chain required to answer the question. \n        Provide a step-by-step breakdown of how to derive the answer.\n        """\n        reasoning_chain = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers based on the reasoning chain\n        candidate_answers_instruction = f"""\n        Using the reasoning chain: {reasoning_chain}\n        Generate multiple candidate answers to the question. \n        Ensure each candidate answer is supported by the provided context documents. \n        Format the output as a list of candidate answers with brief explanations.\n        """\n        candidates = await self.generate(instruction=candidate_answers_instruction, context=self.problem_text)\n\n        # Step 4: Revise and refine the candidate answers\n        revision_instruction = """\n        Critique and refine the candidate answers. \n        Ensure they are accurate, concise, and directly address the question. \n        Remove any ambiguities or unsupported claims.\n        """\n        refined_answers = await self.revise(instruction=revision_instruction, context=candidates)\n\n        # Step 5: Ensemble to select the best answer\n        ensemble_instruction = """\n        Evaluate the refined candidate answers. \n        Select the most accurate, concise, and well-supported answer. \n        If multiple answers are equally valid, provide a synthesis of the best options.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=refined_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instru