red\n        question_analysis_instruction = f"""\n        Based on the extracted entities: {entities}\n        Analyze the type of question being asked. Determine whether it is a bridge question, comparison question, \n        compositional question, or date/time question. Explain the reasoning chain required to answer the question.\n        """\n        question_analysis = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Identify relevant documents and extract supporting facts\n        document_selection_instruction = f"""\n        Using the extracted entities: {entities}\n        And the question analysis: {question_analysis}\n        Identify which documents contain relevant information to answer the question.\n        Extract key sentences or phrases from these documents that support the reasoning chain.\n        """\n        relevant_documents = await self.generate(instruction=document_selection_instruction, context=self.problem_text)\n\n        # Step 4: Perform multi-hop reasoning to derive the answer\n        reasoning_instruction = f"""\n        Using the extracted entities: {entities}\n        Question analysis: {question_analysis}\n        Relevant documents: {relevant_documents}\n        Perform multi-hop reasoning to connect the information across documents.\n        Build a clear reasoning chain step by step.\n        Ensure that each step logically follows from the previous one.\n        """\n        reasoning_chain = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 5: Refine the reasoning chain for clarity and precision\n        refinement_instruction = f"""\n        Review the reasoning chain: {reasoning_chain}\n        Critique and refine it for clarity, precision, and completeness.\n        Ensure that all steps are well-explained and logically connected.\n        """\n        refined_chain = await self.revise(instruction=refinement_in