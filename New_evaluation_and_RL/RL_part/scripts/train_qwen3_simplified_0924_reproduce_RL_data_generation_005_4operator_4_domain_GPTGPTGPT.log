ion = f"""\n        Based on the extracted entities: {entities}\n        Analyze the type of question being asked. Is it a bridge question, comparison question, or compositional question?\n        Identify the reasoning chain required to answer the question. \n        For example, if it\'s a bridge question, determine the bridge entity that connects the documents.\n        If it\'s a comparison question, identify the entities being compared and the property being evaluated.\n        If it\'s a compositional question, outline the sequence of facts needed to derive the answer.\n        Provide a detailed explanation of the reasoning process.\n        """\n        reasoning_chain = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers using multiple approaches\n        approach_1_instruction = f"""\n        Using the reasoning chain: {reasoning_chain}\n        Solve the problem step by step. Focus on extracting precise answer spans from the text.\n        Ensure the answer is concise and directly addresses the question.\n        """\n        approach_1 = await self.generate(instruction=approach_1_instruction, context=self.problem_text)\n\n        approach_2_instruction = f"""\n        Using the reasoning chain: {reasoning_chain}\n        Solve the problem using an alternative method. For example, if the first approach focused on direct extraction,\n        this approach could focus on logical deduction or inference.\n        Ensure the answer is concise and directly addresses the question.\n        """\n        approach_2 = await self.generate(instruction=approach_2_instruction, context=self.problem_text)\n\n        # Step 4: Ensemble the candidate answers to select the best one\n        ensemble_instruction = """\n        Evaluate the two candidate answers provided. \n        Compare their accuracy, completeness, and relevance to the question.\n        Select the best answer based on the reasoning chain and the problem requirements.\n        If both answers are equally valid, provide a merged version that incorporates the strengths of both.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[approach_1, approach_2])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values, entities, and key phrases\n        extraction_instruction = (\n            "Identify and extract all numerical values, entities, and key phrases from the passage. "\n            "Include counts, dates, names, and any other information that might be relevant to answering the question. "\n            "Organize the extracted information in a structured format for clarity."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the type of reasoning required\n        analysis_instruction = (\n            f"Given the extracted