       Also, note any numerical values, dates, or specific attributes that are relevant to the question.\n        Format the output as a structured list of entities and their relationships.\n        """\n        entities = await self.generate(instruction=entity_extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question type and reasoning chain\n        question_analysis_instruction = f"""\n        Based on the extracted entities and relationships: {entities}\n        Analyze the type of question being asked. Is it a bridge question, comparison question, or compositional question?\n        Identify the reasoning chain required to answer the question. \n        For example, if it\'s a bridge question, determine the bridge entity that connects different documents.\n        If it\'s a comparison question, identify the entities being compared and their properties.\n        If it\'s a compositional question, outline the sequence of facts needed to derive the answer.\n        Provide a detailed explanation of the reasoning process.\n        """\n        reasoning_chain = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers from each document\n        document_analysis_instruction = """\n        For each document, extract all relevant information that could contribute to answering the question.\n        Focus on sentences or phrases that mention entities, relationships, or facts directly related to the question.\n        Format the output as a list of candidate answers or supporting facts.\n        """\n        document_analysis_tasks = [\n            self.generate(instruction=document_analysis_instruction, context=document)\n            for document in self.problem_text.split("\\n\\n")  # Assuming documents are separated by line breaks\n        ]\n        document_results = await asyncio.gather(*document_analysis_tasks)\n\n        # Step 4: Evaluate and select the best answer\n        evaluation_instruction = """\n        Review all candidate answers and supporting facts from the documents.\n        Compare them based on relevance, accuracy, and completeness.\n        Select the best answer that directly addresses the question.\n        If there are multiple valid answers, choose the one that is most comprehensive or aligns best with the reasoning chain.\n        """\n        final_answer = await self.ensemble(instruction=evaluation_instruction, contexts=document_results)\n\n        # Step 5: Refine the final answer\n        refinement_instruction = """\n        Critique the selected answer for clarity, precision, and adherence to the reasoning chain.\n        Improve it by ensuring it is concise, well-structured, and free of ambiguities.\n        Format the final answer as a short text span or brief factual response.\n        """\n        refined_answer = await self.revise(instruction=refinement_instruction, context=final_answer)\n\n        return refined_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyn