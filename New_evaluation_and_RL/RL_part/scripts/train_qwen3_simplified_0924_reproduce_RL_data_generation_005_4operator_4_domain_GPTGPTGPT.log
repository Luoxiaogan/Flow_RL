\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = """\n        Identify and extract all numerical values, entities, and their relationships from the passage. \n        Focus on numbers associated with entities like field goals, dates, counts, and other relevant facts. \n        Organize the extracted information in a structured format, clearly associating each number with its corresponding entity.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the required reasoning\n        analysis_instruction = f"""\n        Based on the extracted information: {extracted_info}\n        Analyze the question and determine the type of reasoning required. \n        For example, if the question involves arithmetic operations, specify the operation (addition, subtraction, etc.) \n        and the entities involved. If the question requires comparison, identify the entities to compare. \n        If the question asks for a span extraction, specify the exact phrase or entity to extract.\n        """\n        analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem step by step\n        solve_instruction = f"""\n        Using the extracted information: {extracted_info}\n        And the analysis: {analysis}\n        Solve the problem step by step. \n        Perform any necessary calculations, comparisons, or selections based on the question\'s intent. \n        Ensure that all steps are clearly explained and that the final answer is accurate and well-reasoned.\n        """\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Refine the solution for clarity and correctness\n        refine_instruction = """\n        Critique and refine