hon code, no explanations.\n            """,\n            context=extraction\n        )\n        \n        # Use Ensemble to select the best implementation\n        final_code = await self.ensemble(\n            instruction="""\n            Evaluate the following implementations and select the best one:\n            1. Ensure all test cases are handled correctly.\n            2. Add missing import statements if necessary.\n            3. Fix any logical or syntactical errors.\n            4. Optimize for readability and Pythonic style.\n            Return ONLY the selected Python code, no explanations.\n            """,\n            contexts=[revised_code, alternative_1, alternative_2]\n        )\n        \n        return final_code\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n        # --- YOUR WORKFLOW LOGIC HERE ---\n        \n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = (\n            "Carefully analyze the passage and extract all numerical values and their associated entities. "\n            "Include counts, dates, and any other quantitative information. "\n            "Format the output as a structured list with clear labels for each value and its corresponding entity."\n        )\n        extracted_data = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n        \n        # Step 2: Understand the question and determine the required reasoning\n        question_understanding_instruction = (\n            f"Given the extracted data:\\n{extracted_data}\\n"\n            "Analyze the question and determine what specific calculation, count, or comparison is required. "\n            "Break down the problem into logical steps and identify any missing information."\n        )\n        question_analysis = await self.generate(instruction=question_understanding_instruction, context=self.problem_text)\n        \n        # Step 3: Solve the problem step by step\n        problem_solving_instruction = (\n            f"Based on the following analysis:\\n{question_analysis}\\n"\n            "Use the extracted data to solve the problem step by step. "\n            "Show all intermediate calculations and clearly state the final answer. "\n            "Ensure the answer is formatted as a complete sentence with the correct units or context."\n        )\n        solution = await self.generate(instruction=problem_solving_instruction, context=self.problem_text)\n        \n        # Step 4: Critique and refine the solution\n        refinement_instruction = (\n            f"Review the following solution:\\n{solution}\\n"\n            "Critique it for accuracy, completeness, and clarity. "\n            "Identify any potential errors or ambiguities and suggest improvements."\n        )\n        refined_solution = await self.revise(instruction=refinement_instruction, context=solution)\n        \n        # Step 5: Ensemble multiple approaches if needed\n        # For demonstration, we\'ll assume two independent approaches were generated\n        approach_1 = await self.generate(\n            instruction="Solve the problem using a direct calculation approach.",\n            context=self.problem_text\n        )\n        approach_2 = await self.generate(\n            instruction="Solve the problem using an indirect reasoning approach.",\n            context=self.problem_text\n        )\n        \n        ensemble_instruction = (\n            "Compare the following two approaches:\\n"\n            f"Approach 1:\\n{approach_1}\\n"\n            f"Approach 2:\\n{approach_2}\\n"\n            "Evaluate their strengths and weaknesses. Select the best approach or synthesize the results into a single, coherent answer."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[approach_1, approach_2])\n        \n        # Step 6: Summarize the final result\n        summarization_instruction = (\n            f"Summarize the final answer:\\n{final_answer}\\n"\n            "Ensure the summary is concise, accurate, and directly answers the question."\n        )\n        final_summary = await self.summarize(instruction=summarization_instruction, context=final_answer)\n        \n        return final_summary\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instru