tion\n        analysis_instruction = (\n            f"Using the extracted information: {extracted_info}\\n"\n            "1. Clearly state what the problem is asking for.\\n"\n            "2. Break down the problem into sequential steps or sub-problems.\\n"\n            "3. For each step, specify the mathematical operation(s) required and the order of operations.\\n"\n            "4. Ensure all units are consistent and accounted for.\\n"\n            "5. Provide a detailed plan for solving the problem step by step."\n        )\n        problem_plan = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem step by step\n        solve_instruction = (\n            f"Follow this problem-solving plan: {problem_plan}\\n"\n            "1. Perform each calculation step-by-step, showing intermediate results.\\n"\n            "2. Ensure all units are properly tracked and converted if necessary.\\n"\n            "3. Verify that the final answer makes sense in the context of the problem.\\n"\n            "4. Format the final answer clearly, including the unit of measurement."\n        )\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = (\n            f"Review the following solution: {solution}\\n"\n            "1. Check for any errors in calculations or reasoning.\\n"\n            "2. Ensure all steps are logically sound and consistent with the problem statement.\\n"\n            "3. Suggest improvements or corrections if necessary.\\n"\n            "4. Provide a revised version of the solution if needed."\n        )\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = (\n            f"Summarize the final solution: {refined_solution}\\n"\n            "1. Highlight the key steps and calculations.\\n"\n            "2. Emphasize the final numerical answer and its unit.\\n"\n            "3. Ensure the summary is concise and directly answers the question."\n        )\n        final_summary = await self.summarize(instruction=summarize_instruction, context=refined_solution)\n\n        # Step 6: Ensemble decision (optional but powerful for robustness)\n        ensemble_instruction = (\n            f"Compare the following solutions:\\n"\n            f"1. Original Solution: {solution}\\n"\n            f"2. Refined Solution: {refined_solution}\\n"\n            "1. Evaluate which solution is more accurate, complete, and consistent with the problem.\\n"\n            "2. Select the best solution and provide a final recommendation."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[solution, refined_solution])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all numerical values and relationships\n        extraction_ins