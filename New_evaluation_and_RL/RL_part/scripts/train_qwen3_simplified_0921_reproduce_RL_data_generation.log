tr, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all key dates and events from the passage\n        extraction_instruction = """\n        Identify and extract all key dates and events mentioned in the passage. \n        Organize them in chronological order, clearly indicating the date and the event.\n        Ensure that all relevant information is captured, including any implicit or inferred dates.\n        """\n        extracted_dates_events = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Identify the specific event related to the punitive operation\n        identify_instruction = f"""\n        Given the extracted dates and events: {extracted_dates_events}\n        Identify the event that corresponds to the punitive operation mentioned in the question.\n        Focus on the date associated with the start of this operation.\n        """\n        punitive_operation_info = await self.generate(instruction=identify_instruction, context=self.problem_text)\n\n        # Step 3: Refine the identified information for accuracy\n        refinement_instruction = f"""\n        Review the following information: {punitive_operation_info}\n        Ensure that the date provided is accurate and corresponds to the start of the punitive operation.\n        If there is any ambiguity, resolve it by cross-referencing the original passage.\n        """\n        refined_info = await self.revise(instruction=refinement_instruction, context=punitive_operation_info)\n\n        # Step 4: Summarize the final answer\n        summarize_instruction = f"""\n        Based on the refined information: {refined_info}\n        Provide a concise summary of the date when the punitive operation began.\n        Ensure the answer is clear and directly addresses the question.\n        """\n        final_answer = await self.summarize(instruction=summarize_instruction, context=refined_info)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all numerical values and relationships\n        extraction_instruction = """\n        Identify and extract all numerical values, units, and relationships mentioned in the problem. \n        Include any implicit or explicit calculations or constraints. \n        Format the extracted information clearly for further processing.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the problem and plan the solution\n        analysis_instruction = f"""\n        Given the extracted information: {extracted_info}\n        Analyze the problem step by step. Identify the sequence of operations required to solve it.\n        Include intermediate calculations and ensure unit consistency throughout.\n        Provide a detailed plan for solving the problem.\n        """\n        solution_plan = await self.generate(instruction=analysis_instruction, conte