xt=self.problem_text)\n\n        # Step 3: Generate candidate solutions based on the reasoning type\n        candidate_solutions = await asyncio.gather(\n            self.generate(\n                instruction=f"Given the reasoning type: {reasoning_type}, "\n                "generate a detailed step-by-step solution to the problem. "\n                "Ensure all intermediate steps are clearly explained.",\n                context=self.problem_text\n            ),\n            self.generate(\n                instruction=f"Given the reasoning type: {reasoning_type}, "\n                "generate an alternative solution approach. "\n                "Focus on differentiating this solution from the first one.",\n                context=self.problem_text\n            )\n        )\n\n        # Step 4: Ensemble the candidate solutions to select the best one\n        ensemble_instruction = (\n            "Evaluate the two candidate solutions provided. "\n            "Compare their reasoning chains, accuracy, and completeness. "\n            "Select the solution that best addresses the problem and provide a justification for your choice."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=candidate_solutions)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n     