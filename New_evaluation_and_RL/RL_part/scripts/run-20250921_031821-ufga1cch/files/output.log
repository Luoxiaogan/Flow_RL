ruction = f"""\n        Using the reasoning chain: {reasoning_chain}\n        Synthesize the final answer by combining all relevant information.\n        Ensure the answer is concise, accurate, and directly addresses the question.\n        """\n        synthesized_answer = await self.generate(instruction=synthesis_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the answer\n        critique_instruction = """\n        Critically evaluate the synthesized answer for accuracy, completeness, and clarity.\n        Suggest improvements if necessary.\n        """\n        refined_answer = await self.revise(instruction=critique_instruction, context=synthesized_answer)\n\n        # Step 5: Ensemble decision (optional but powerful)\n        ensemble_instruction = """\n        Compare the synthesized and refined answers.\n        Select the best answer based on accuracy, clarity, and relevance to the question.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[synthesized_answer, refined_answer])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: s