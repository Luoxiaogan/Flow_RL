['<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships from the problem\n        extraction_instruction = """\n        Identify all entities, relationships, and key facts mentioned in the question. \n        Focus on entities like people, organizations, events, and their connections. \n        Extract any numerical values, dates, or specific attributes that are relevant to the question.\n        Format the output as a structured summary with clear labels for each extracted piece of information.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the extracted information to determine the reasoning type\n        analysis_instruction = f"""\n        Based on the following extracted information:\n        {extracted_info}\n        Determine the type of reasoning required to answer the question. \n        Is it a bridge question, comparison question, compositional question, or date/time question?\n        Provide a detailed explanation of the reasoning strategy and how the information connects to the question.\n        """\n        reasoning_strategy = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers using the reasoning strategy\n        candidate_answers_instruction = f"""\n        Using the reasoning strategy outlined below:\n        {reasoning_strategy}\n        Generate multiple candidate answers to the question. \n        Ensure each candidate answer is supported by the extracted information and logical inference.\n        Format the output as a list of candidate answers with brief explanations for each.\n        """\n        candidates = await self.generate(instruction=candidate_answers_instruction, context=self.problem_text)\n\n        # Step 4: Refine the candidate answers for clarity and accuracy\n        refinement_instruction = """\n        Critique and refine the following candidate answers for clarity, accuracy, and completeness. \n        Ensure that each answer is concise, directly addresses the question, and is supported by the reasoning strategy.\n        Format the output as a list of refined answers with brief explanations for each.\n        """\n        refined_answers = await self.revise(instruction=refinement_instruction, context=candidates)\n\n        # Step 5: Ensemble the refined answers to select the best one\n        ensemble_instruction = """\n        Evaluate the following refined answers and select the best one based on clarity, accuracy, and relevance to the question. \n        Provide a detailed justification for your selection.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=refined_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n   