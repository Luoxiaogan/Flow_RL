o\n\n        # Step 1: Extract key entities and relationships from the problem\n        extraction_instruction = """\n        Identify all key entities, relationships, and the type of reasoning required to answer the question.\n        Specifically, extract:\n        - The question being asked\n        - Any entities mentioned in the question\n        - The type of reasoning needed (e.g., bridge entity, comparison, multi-hop fact)\n        - Any specific constraints or requirements\n        Format the output as a structured summary.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the extracted information to determine the reasoning strategy\n        analysis_instruction = f"""\n        Based on the following extracted information:\n        {extracted_info}\n        Determine the reasoning strategy required to answer the question.\n        Specifically, decide:\n        - Whether the question requires connecting information across documents (bridge entity)\n        - Whether it involves comparing properties of entities (comparison)\n        - Whether it requires combining multiple facts (compositional)\n        - Any specific steps or intermediate facts needed\n        Provide a detailed plan for solving the problem.\n        """\n        reasoning_plan = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Execute the reasoning plan by generating candidate answers\n        candidate_answers = await asyncio.gather(\n            self.generate(\n                instruction=f"""\n                Follow this reasoning plan:\n                {reasoning_plan}\n                Generate a candidate answer based on the first approach.\n                Ensure the answer is concise and directly addresses the question.\n                """,\n                context=self.problem_text\n            ),\n            self.generate(\n  