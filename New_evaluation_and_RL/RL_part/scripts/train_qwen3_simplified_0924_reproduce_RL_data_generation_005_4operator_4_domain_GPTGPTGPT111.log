 initial solution based on the extracted information\n        initial_solution_instruction = f"""\n        Using the extracted information: {extracted_info}\n        Generate a complete Python function implementation that satisfies the problem specification.\n        Ensure the function matches the provided signature and handles all edge cases mentioned in the docstring.\n        Include detailed comments explaining the logic and reasoning.\n        """\n        initial_solution = await self.generate(instruction=initial_solution_instruction, context=self.problem_text)\n\n        # Step 3: Revise the initial solution for correctness and efficiency\n        revision_instruction = """\n        Critique the provided solution for correctness, efficiency, and adherence to the problem specification.\n        Identify any potential issues such as off-by-one errors, type mismatches, or missing edge cases.\n        Suggest improvements or corrections to ensure the solution is robust and passes all test cases.\n        """\n        revised_solution = await self.revise(instruction=revision_instruction, context=initial_solution)\n\n        # Step 4: Summarize the revised solution to ensure clarity and completeness\n        summary_instruction = """\n        Condense the revised solution into a concise summary that highlights the key steps and logic.\n        Ensure the summary includes all necessary details for understanding the implementation.\n        """\n        solution_summary = await self.summarize(instruction=summary_instruction, context=revised_solution)\n\n        # Step 5: Ensemble to select the best solution\n        ensemble_instruction = """\n        Evaluate the following candidate solutions and select the best one:\n        1. Initial Solution: {initial_solution}\n        2. Revised Solution: {revised_solution}\n        3. Solution Summary: {solution_summary}\n        Choose the solution that is most complete, efficient, and adheres to the problem specification.\