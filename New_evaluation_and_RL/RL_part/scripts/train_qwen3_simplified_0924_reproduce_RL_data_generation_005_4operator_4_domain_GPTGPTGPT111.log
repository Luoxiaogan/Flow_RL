ion from the problem statement\n        extraction_instruction = """\n        Analyze the problem statement and extract:\n        1. The function signature (name, parameters, return type)\n        2. The docstring description and examples\n        3. Any constraints or special conditions mentioned\n        Format the output as a JSON-like structure for clarity.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Generate an initial implementation based on the extracted information\n        initial_implementation_instruction = f"""\n        Using the extracted information:\n        - Function signature: {extracted_info}\n        - Docstring description and examples: {extracted_info}\n        - Constraints: {extracted_info}\n        Generate a complete Python function implementation that satisfies the problem requirements.\n        Ensure the function matches the provided signature and handles all edge cases mentioned in the docstring.\n        """\n        initial_implementation = await self.generate(instruction=initial_implementation_instruction, context=self.problem_text)\n\n        # Step 3: Critique and refine the initial implementation\n        critique_instruction = """\n        Review the provided implementation and critique it based on the following criteria:\n        1. Does it match the function signature and docstring description?\n        2. Are all edge cases handled correctly?\n        3. Is the code efficient and readable?\n        Provide suggestions for improvement.\n        """\n        critique = await self.revise(instruction=critique_instruction, context=initial_implementation)\n\n        # Step 4: Generate a revised implementation based on the critique\n        revised_implementation_instruction = f"""\n        Using the critique: {critique}\n        Refine the initial implementation to address any issues identified.\n        Ensure the function is correct,