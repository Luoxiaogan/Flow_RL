   )\n        reasoning_type = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Build reasoning chains or compare options\n        reasoning_instruction = (\n            f"Given the reasoning type: {reasoning_type}\\n"\n            "Construct a detailed reasoning chain or set of candidate solutions. "\n            "If the reasoning is bridge-based, identify the connecting entity and how it links the documents. "\n            "If it\'s comparison-based, compare the relevant properties of the entities. "\n            "If it\'s compositional, combine the facts step by step. "\n            "Ensure the reasoning is explicit and leaves no ambiguity."\n        )\n        reasoning_chain = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 4: Refine the reasoning chain for clarity and correctness\n        refinement_instruction = (\n            f"Review the following reasoning chain: {reasoning_chain}\\n"\n            "Critique it for clarity, completeness, and correctness. "\n            "Suggest improvements or corrections where necessary. "\n            "Provide a revised version of the reasoning chain."\n        )\n        refined_chain = await self.revise(instruction=refinement_instruction, context=reasoning_chain)\n\n        # Step 5: Extract the final answer from the refined reasoning chain\n        extraction_instruction_final = (\n            f"From the refined reasoning chain: {refined_chain}\\n"\n            "Extract the final answer to the question. "\n            "Ensure the answer is concise, precise, and directly addresses the question. "\n            "Format the answer as a short text span or brief factual response."\n        )\n        final_answer = await self.generate(instruction=extraction_instruction_final, context=refined_chain)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key information from the problem text\n        extraction_instruction = (\n            "Extract the function signature, docstring, and all examples provided. "\n            "Identify the task, input format, output format, and any edge cases mentioned."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the extracted information to understand the problem\n        analysis_instruction = (\n            f"Given the extracted information: {extracted_info}\\n"\n            "Analyze the problem step by step. Identify the core algorithm or logic required. "\n            "Determine how to handle edge cases and ensure the solution matches the expected output format."\n        )\n        analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate the initial solution based on the analysis\n        solution_instruction = (\n            f"Based on the analysis: {analysis}\\n"\n            "Generate a complete Python function implementation that satisfies the docstring specification. "\n            "Ensure the function signature matches exactly and handles all edge cases mentioned."\n        )\n        initial_solution = await self.generate(instruction=solution_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the initial solution\n        critique_instruction = (\n            f"Review the initial solution: {initial_solution}\\n"\n            "Critique it for correctness, efficiency, and adherence to the docstring specification. "\n            "Identify any potential issues or improvements."\n        )\n        critique = await self.revise(instruction=critique_instruction, context=initial_solution)\n\n        # Step 5: Generate an improved solution based on the critique\n        improved_solution_instruction = (\n            f"Based on the critique: {critique}\\n"\n            "Generate an improved version of the solution. Ensure it is correct, efficient, and adheres to the docstring specification."\n        )\n        improved_solution = await self.generate(instruction=improved_solution_instruction, context=self.problem_text)\n\n        # Step 6: Ensemble to select the best solution\n        ensemble_instruction = (\n            f"Compare the initial solution: {initial_solution}\\n"\n            f"and the improved solution: {improved_solution}\\n"\n            "Select the best solution based on correctness, efficiency, and adherence to the docstring specification."\n        )\n        final_solution = await self.ensemble(instruction=ensemble_instruction, contexts=[initial_solution, improved_solution])\n\n        return final_solution\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = 