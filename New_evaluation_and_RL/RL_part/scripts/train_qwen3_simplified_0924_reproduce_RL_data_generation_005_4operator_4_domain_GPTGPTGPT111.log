  - Compositional Question: Combines multiple facts\n        - Date/Time Question: Involves temporal reasoning\n        Provide a clear explanation of your reasoning.\n        """\n        reasoning_type = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers using parallel approaches\n        candidate_answers = await asyncio.gather(\n            self.generate(\n                instruction=f"""\n                Given the reasoning type: {reasoning_type}\n                Use the extracted information: {extracted_info}\n                Solve the problem step by step, ensuring all logical connections are explicitly made.\n                Provide the final answer as a concise text span.\n                """,\n                context=self.problem_text\n            ),\n            self.generate(\n                instruction=f"""\n                Given the reasoning type: {reasoning_type}\n                Use the extracted information: {extracted_info}\n                Solve the problem using an alternative approach.\n                Ensure the reasoning is distinct from the first method.\n                Provide the final answer as a concise text span.\n                """,\n                context=self.problem_text\n            )\n        )\n\n        # Step 4: Ensemble the candidate answers to select the best one\n        ensemble_instruction = f"""\n        Evaluate the following candidate answers:\n        - Candidate 1: {candidate_answers[0]}\n        - Candidate 2: {candidate_answers[1]}\n        Select the best answer based on accuracy, completeness, and adherence to the reasoning type.\n        If both are equally valid, provide a merged or synthesized version.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=candidate_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key information from the problem text\n        extraction_instruction = (\n            "Extract the function signature, docstring, and all examples provided. "\n            "Identify the task, input format, output format, and any edge cases mentioned."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Generate an initial solution based on the extracted information\n        initial_solution_instruction = (\n            f"Given the extracted information: {extracted_info}\\n"\n            "Implement the function as described in the docstring. "\n            "Ensure the function signature matches exactly. "\n            "Handle all edge cases mentioned in the docstring. "\n            "Include detailed comments explaining the logic."\n        )\n        initial_solution = await self.generate(instruction=initial_solution_instruction, context=self.problem_text)\n\n        # Step 3: Critique and refine the initial solution\n        critique_instruction = (\n            f"Given the initial solution: {initial_solution}\\n"\n            "Critique the solution for correctness, completeness, and adherence to the docstring. "\n            "Identify any potential issues or improvements."\n        )\n        critique = await self.revise(instruction=critique_instruction, context=initial_solution)\n\n        # Step 4: Generate an alternative solution if needed\n        alternative_solution_instruction = (\n            f"Given the critique: {critique}\\n"\n            "Generate an alternative solution that addresses the identified issues. "\n            "Ensure the function signature matches exactly. "\n            "Handle all edge cases mentioned in the docstring. "\n            "Include detailed comments explaining the logic."\n        )\n        alternative_solution = await self.generate(instruction=alternative_solution_instruction, context=self.problem_text)\n\n        # Step 5: Ensemble the solutions to select the best one\n        ensemble_instruction = (\n            f"Given the initial solution: {initial_solution}\\n"\n            f"and the alternative solution: {alternative_solution}\\n"\n            "Compare the two solutions based on correctness, completeness, and adherence to the docstring. "\n            "Select the best solution and provide a final version."\n        )\n        final_solution = await self.ensemble(instruction=ensemble_instruction, contexts=[initial_solution, alternative_solution])\n\n        # Step 6: Return the final solution\n        return final_solution\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract the function name from the test cases\n        func_name = await self.generate(\n            instruction="""\n            Analyze the test cases provided in the problem description.\n            Extract the function name that is used in the test cases.\n            Return ONLY the function name, nothing else.\n            """,\n            context=self.problem_text\n        )\n\n        # Step 2: Generate the initial implementation of the function\n        initial_code = await self.generate(\n            instruction=f"""\n            Write a Python function named \'{func_name}\' that solves the task described in the problem.\n            Requirements:\n            1. Include ALL necessary import statements at the top.\n            2. Handle edge cases (empty inputs, None, boundaries).\n            3. Return ONLY the executable Python code, no explanations.\n            """,\n            context=self.problem_text\n        )\n\n        # Step 3: Revise the code to ensure correctness and completeness\n        revised_code = await self.revise(\n            instruction="""\n            Review the provided Python code for correctness and completeness.\n            Ensure:\n            - All edge cases are handled.\n            - The function signature matches the test cases.\n            - Necessary imports are included.\n            - The code is Pythonic and follows best practices.\n            Return ONLY the corrected code, no explanations.\n  