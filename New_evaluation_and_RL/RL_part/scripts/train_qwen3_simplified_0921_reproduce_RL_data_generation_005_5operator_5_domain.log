nit__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant entities and relationships\n        entity_extraction_instruction = """\n        Identify all entities, relationships, and key facts mentioned in the problem. \n        Focus on entities such as people, places, organizations, and events. \n        Also, note any numerical values, dates, or comparisons explicitly stated in the question.\n        Format the output as a structured list of key-value pairs or bullet points.\n        """\n        entities = await self.generate(instruction=entity_extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question type and reasoning chain\n        analysis_instruction = f"""\n        Based on the extracted entities: {entities}\n        Determine the type of question being asked (e.g., bridge, comparison, compositional).\n        Identify the reasoning chain required to answer the question.\n        For example, if it\'s a bridge question, specify the bridge entity and the documents involved.\n        If it\'s a comparison question, identify the entities being compared and the criteria.\n        If it\'s a compositional question, outline the sequence of facts needed to derive the answer.\n        """\n        reasoning_chain = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Generate candidate answers from relevant documents\n        candidate_answers_instruction = f"""\n        Using the reasoning chain: {reasoning_chain}\n        Extract specific sentences or phrases from the provided documents that support the reasoning chain.\n        Generate candidate answers based on these supporting facts.\n        Ensure each candidate answer is clearly labeled and includes its source document.\n        """\n        candidate_answers = await self.generate(instruction=candidate_answers_instruction, context=self.problem_text)\n\n        # Step 4: Refine and critique the candidate answers\n        refinement_instruction = """\n        Critique the candidate answers for accuracy, completeness, and relevance to the question.\n        Ensure that each answer is supported by the reasoning chain and the extracted entities.\n        Suggest improvements or corrections if necessary.\n        """\n        refined_answers = await self.revise(instruction=refinement_instruction, context=candidate_answers)\n\n        # Step 5: Ensemble to select the best answer\n        ensemble_instruction = """\n        Evaluate the refined answers and select the best one based on the following criteria:\n        - Accuracy: Does the answer correctly address the question?\n        - Completeness: Does it include all necessary information?\n        - Relevance: Is it directly related to the reasoning chain?\n        Provide a final, concise answer that incorporates the best aspects of the refined answers.\n        """\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=refined_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def _