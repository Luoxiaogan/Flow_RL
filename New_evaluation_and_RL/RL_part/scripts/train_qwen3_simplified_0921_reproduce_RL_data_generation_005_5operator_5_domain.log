uction, context=self.problem_text)\n\n        # Step 4: Extract supporting facts from the relevant documents\n        fact_extraction_instruction = (\n            f"From the identified relevant documents: {relevant_documents}, "\n            "extract all supporting facts that are relevant to the question. "\n            "Ensure the facts are precise and directly related to the reasoning type identified."\n        )\n        supporting_facts = await self.generate(instruction=fact_extraction_instruction, context=self.problem_text)\n\n        # Step 5: Build the reasoning chain\n        reasoning_chain_instruction = (\n            f"Using the extracted supporting facts: {supporting_facts}, "\n            "construct a step-by-step reasoning chain that leads to the answer. "\n            "Ensure the chain is logical and connects the facts in a way that answers the question."\n        )\n        reasoning_chain = await self.generate(instruction=reasoning_chain_instruction, context=self.problem_text)\n\n        # Step 6: Generate the final answer\n        final_answer_instruction = (\n            f"Based on the reasoning chain: {reasoning_chain}, "\n            "generate the final answer to the question. "\n            "Ensure the answer is concise, precise, and directly addresses the question."\n        )\n        final_answer = await self.generate(instruction=final_answer_instruction, context=self.problem_text)\n\n        # Step 7: Refine the final answer for clarity and correctness\n        refinement_instruction = (\n            "Critique the final answer for clarity, correctness, and completeness. "\n            "Refine it to ensure it is well-structured and free of errors."\n        )\n        refined_answer = await self.revise(instruction=refinement_instruction, context=final_answer)\n\n        # Step 8: Summarize the entire process\n        summary_instruction = (\n            "Summarize the entire problem-solving process, including the reasoning type, "\n         