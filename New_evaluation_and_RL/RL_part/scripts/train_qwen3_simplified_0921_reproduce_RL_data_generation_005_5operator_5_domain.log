       """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Identify all entities, relationships, and potential bridges between documents. "\n            "Focus on shared entities and logical connections that could help answer the question."\n        )\n        extraction = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze document relevance and reasoning\n        analysis_instruction = (\n            f"Given the extracted information: {extraction}, analyze which documents are most relevant "\n            "to the question and how they connect. Provide a detailed reasoning chain."\n        )\n        analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Synthesize information using Ensemble\n        synthesis_instruction = (\n            "Compare the extracted information and analysis. Synthesize a coherent answer that "\n            "connects the relevant documents and resolves any ambiguities."\n        )\n        synthesis = await self.ensemble(\n            instruction=synthesis_instruction,\n            contexts=[extraction, analysis]\n        )\n\n        # Step 4: Refine the final answer\n        refinement_instruction = (\n            "Review the synthesized answer and refine it to ensure accuracy, clarity, and conciseness. "\n            "Ensure it directly addresses the question."\n        )\n        final_answer = await self.revise(instruction=refinement_instruction, context=synthesis)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key components from the problem text\n        extraction_instruction = (\n            "Carefully analyze the problem statement and extract all relevant information, "\n            "including the function signature, examples, edge cases, and any mathematical or logical patterns. "\n            "Ensure that the extracted information is complete and precise."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Generate an initial solution based on the extracted information\n        initial_solution_instruction = (\n            f"Using the extracted information: {extracted_info}, "\n            "create a complete Python function implementation that satisfies the problem specification. "\n            "Ensure that the function adheres to the provided signature and handles all edge cases mentioned in the docstring. "\n            "Include detailed comments explaining the logic."\n        )\n        initial_solution = await self.generate(instruction=initial_solution_instruction, context=self.problem_text)\n\n        # Step 3: Revise the initial solution for correctness and clarity\n        revision_instruction = (\n            "Critique the initial solution and identify any potential issues, such as logical errors, "\n            "type mismatches, or inefficiencies. Refine the solution to ensure it is correct, efficient, and well-documented."\n        )\n        revised_solution = await self.revise(instruction=revision_instruction, context=initial_solution)\n\n        # Step 4: Summarize the key aspects of the solution\n        summary_instruction = (\n            "Condense the revised solution into a concise summary that highlights the core logic, "\n            "key steps, and how it meets the problem requirements."\n        )\n        solution_summary = await self.summarize(instruction=summary_instruction, context=revised_solution)\n\n        # Step 5: Ensemble decision to select the best solution\n        ensemble_instruction = (\n            "Evaluate the initial solution, revised solution, and their summaries. "\n            "Select the best solution based on correctness, clarity, and adherence to the problem specification. "\n            "If necessary, synthesize the best aspects of both solutions into a single optimal implementation."\n        )\n        final_solution = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[initial_solution, revised_solution, solution_summary]\n        )\n\n        return final_solution\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, compre