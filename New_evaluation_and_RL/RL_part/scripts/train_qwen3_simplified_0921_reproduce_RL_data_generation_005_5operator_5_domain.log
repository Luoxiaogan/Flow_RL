truction = """\n        Review the provided solution and critique it for accuracy, completeness, and clarity.\n        Suggest any improvements or corrections if necessary.\n        """\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = """\n        Condense the refined solution into a concise summary that captures the key reasoning and final answer.\n        Ensure the summary is clear and directly addresses the question.\n        """\n        final_summary = await self.summarize(instruction=summarize_instruction, context=refined_solution)\n\n        # Step 6: Ensemble to decide on the best final answer\n        ensemble_instruction = """\n        Evaluate the following candidate solutions and select the best one based on accuracy, completeness, and clarity.\n        Provide the final answer in a box as per the DROP benchmark format.\n        """\n        results = await asyncio.gather(\n            self.generate(instruction="Provide an alternative solution if possible.", context=self.problem_text),\n            self.generate(instruction="Provide another alternative solution if possible.", context=self.problem_text)\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[final_summary] + results)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.pro