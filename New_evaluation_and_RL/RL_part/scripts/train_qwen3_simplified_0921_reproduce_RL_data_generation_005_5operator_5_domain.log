e.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant information from the passage\n        extraction_instruction = """\n        Carefully read the entire passage and extract all numerical values, named entities, and key facts. \n        Include any relationships between entities, such as comparisons, counts, or sequences. \n        Ensure that all relevant information is captured, even if it seems minor or indirect.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the required reasoning\n        analysis_instruction = f"""\n        Given the extracted information: {extracted_info}\n        Analyze the question to determine what type of reasoning is needed. \n        Identify whether the question requires counting, comparison, arithmetic operations, or span extraction. \n        Break down the question into smaller steps if necessary. \n        Provide a clear plan for solving the problem.\n        """\n        reasoning_plan = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem using the reasoning plan\n        solve_instruction = f"""\n        Based on the reasoning plan: {reasoning_plan}\n        Solve the problem step by step. \n        Ensure that all calculations are accurate and that the final answer is clearly stated. \n        If multiple approaches are possible, evaluate them and choose the most appropriate one.\n        """\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = """\n        Critically evaluate the solution for accuracy, completeness, and clarity. \n        Check for any errors in reasoning or calculations. \n        Refine the solution if necessary to ensure it fully addresses the question.\n        """\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = """\n        Condense the refined solution into a concise summary. \n        Ensure that the summary includes the final answer and any key reasoning steps. \n        Avoid unnecessary details while preserving the essential information.\n        """\n        final_summary = await self.summarize(instruction=summarize_instruction, context=refined_solution)\n\n        # Step 6: Ensemble decision if multiple solutions exist\n        ensemble_instruction = """\n        Evaluate the final summary and any other candidate solutions. \n        Choose the best solution based on accuracy, clarity, and relevance to the question. \n        If there are multiple valid answers, select the one that best fits the context.\n        """\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[final_summary]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the co