l_solution = await self.generate(instruction=generate_instruction, context=self.problem_text)\n\n        # Step 3: Revise the initial solution for correctness and clarity\n        revise_instruction = (\n            "Review the initial solution and critique it for correctness, clarity, and adherence to the problem specification. "\n            "Identify any potential issues or improvements. Provide a revised version of the solution."\n        )\n        revised_solution = await self.revise(instruction=revise_instruction, context=initial_solution)\n\n        # Step 4: Summarize the final solution to ensure it meets all requirements\n        summarize_instruction = (\n            "Condense the final solution into a concise summary that highlights its key components and ensures it meets all requirements. "\n            "Include any necessary imports or formatting details."\n        )\n        final_summary = await self.summarize(instruction=summarize_instruction, context=revised_solution)\n\n        # Step 5: Ensemble decision to select the best solution\n        ensemble_instruction = (\n            "Evaluate the initial solution, revised solution, and final summary. "\n            "Select the best solution based on correctness, clarity, and adherence to the problem specification. "\n            "Provide the final Python function implementation."\n        )\n        final_solution = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[initial_solution, revised_solution, final_summary]\n        )\n\n        return final_solution\n```', '<think>\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.