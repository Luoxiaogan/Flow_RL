an.\n        Break down the reasoning process step by step, ensuring that all relevant information is considered.\n        """\n        reasoning = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem using the reasoning\n        solve_instruction = f"""\n        Based on the following reasoning: {reasoning}\n        Solve the problem step by step. \n        Ensure that all calculations are accurate and that the final answer is clearly stated.\n        If the answer requires multiple steps, break them down and provide intermediate results.\n        """\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Revise the solution for clarity and correctness\n        revise_instruction = """\n        Critique the solution for clarity, accuracy, and completeness. \n        Ensure that the final answer is well-justified and directly addresses the question.\n        Make any necessary improvements or corrections.\n        """\n        revised_solution = await self.revise(instruction=revise_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = """\n        Condense the final solution into a concise summary. \n        Ensure that the summary includes the final answer and any key reasoning steps.\n        """\n        final_answer = await self.summarize(instruction=summarize_instruction, context=revised_solution)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        s