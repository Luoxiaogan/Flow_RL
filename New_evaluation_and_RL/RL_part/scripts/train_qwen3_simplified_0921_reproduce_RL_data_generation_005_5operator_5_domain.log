        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = """\n        Identify and extract all numerical values, dates, and named entities from the passage. \n        Include any numbers associated with entities (e.g., "4-yard touchdown run" should extract 4 and "touchdown run").\n        Format the output as a structured list with clear labels for each extracted piece of information.\n        """\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the required reasoning\n        analysis_instruction = f"""\n        Given the extracted information: {extracted_info}\n        Analyze the question to determine what it is asking for. \n        Identify whether the question requires counting, arithmetic operations, comparison, or span extraction.\n        Provide a step-by-step plan for solving the question based on the extracted information.\n        """\n        analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the question using the analysis\n        solve_instruction = f"""\n        Based on the following analysis: {analysis}\n        Solve the question step by step. \n        Ensure that all calculations, comparisons, or selections are clearly explained.\n        Provide the final answer in a box as per the DROP benchmark format.\n        """\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = """\n        Review the provided solution and critique it for accuracy, completeness, and clarity.\n        Suggest any improvements or corrections if necessary.\n        """\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = """\n        Condense the refined solution into a concise summary that captures the key reasoning and final answer.\n        Ensure the summary is clear and directly addresses the question.\n        """\n        final_summary = await self.summarize(instruction=summarize_instruction, context=refined_solution)\n\n        # Step 6: Ensemble to decide on the best final answer\n        ensemble_instruction = """\n        Evaluate the following candidate solutions and select the best one based on accuracy, completeness, and clarity.\n        Provide the final answer in a box as per the DROP benchmark format.\n        """\n        results = await asyncio.gather(\n            self.generate(instruction="Provide an alternative solution if possible.", context=self.problem_text),\n            self.generate(instruction="Provide another alternative solution if possible.", context=self.problem_text)\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[final_summary] + results)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.pro