ate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 3: Verify the solution\n        verify_instruction = (\n            f"Review the solution: {solution}. Check for any errors in calculations or logic. "\n            "Ensure that the answer makes sense in the context of the problem. "\n            "If there are any inconsistencies, correct them."\n        )\n        verified_solution = await self.revise(instruction=verify_instruction, context=solution)\n\n        # Step 4: Ensemble decision (optional but recommended for robustness)\n        ensemble_instruction = (\n            "Compare the original solution and the verified solution. "\n            "Select the best one based on accuracy and completeness. "\n            "If they are similar, choose one as the final answer."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[solution, verified_solution])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Carefully analyze the problem and extract all key entities, relationships, and numerical values. "\n            "Identify the question type (bridge, comparison, compositional, or date/time) and note any specific patterns. "\n            "Ensure the output is structured and includes all relevant information for subsequent reasoning steps."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the extracted information and build reasoning chains\n        reasoning_instruction = (\n            f"Using the extracted information: {extracted_info}, analyze the problem step by step. "\n            "Identify the reasoning chain required to answer the question. "\n            "If the question involves multiple documents, determine which documents are relevant and how they connect. "\n            "If the question requires comparison, evaluate the properties of the entities involved. "\n            "If the question is compositional, combine the relevant facts to derive the answer. "\n            "Ensure the reasoning is explicit and includes all necessary steps."\n        )\n        reasoning_chain = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 3: Generate the final answer based on the reasoning chain\n        answer_instruction = (\n            f"Based on the reasoning chain: {reasoning_chain}, generate the final answer to the question. "\n            "Ensure the answer is concise, accurate, and directly addresses the question. "\n            "If the answer is a short text span, extract it precisely. "\n            "If the answer is yes/no, provide only the boolean value. "\n            "If the answer is a date or number, format it correctly."\n        )\n        final_answer = await self.generate(instruction=answer_instruction, context=self.problem_text)\n\n        # Step 4: Ensemble refinement (optional but recommended for robustness)\n        refinement_instruction = (\n            "Review the final answer and ensure it is accurate, complete, and consistent with the reasoning chain. "\n            "If there are multiple possible interpretations, select the most plausible one. "\n            "If the answer is ambiguous, clarify it based on the context."\n        )\n        refined_answer = await self.revise(instruction=refinement_instruction, context=final_answer)\n\n        # Step 5: Final decision using Ensemble (if multiple candidate answers exist)\n        ensemble_instruction = (\n            "Evaluate the final answer and the refined answer. "\n            "Select the best answer based on accuracy, completeness, and relevance to the question. "\n            "If there are multiple valid answers, explain why one is preferred over the others."\n        )\n        final_decision = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[final_answer, refined_answer]\n        )\n\n        return final_decision\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = (\n            "Carefully analyze the passage and extract all numerical values, "\n            "entities, and key facts that are relevant to answering the question. "\n            "Include all occurrences of numbers, names, dates, and any other "\n            "information that might be needed for reasoning. Organize the extracted "\n            "information clearly for further processing."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Understand the question and determine the required operation\n        question_analysis_instruction = (\n            f"Given the extracted information: {extracted_info}, "\n            "analyze the question to determine what type of reasoning is required. "\n            "Identify whether the question involves arithmetic operations, counting, "\n            "comparison, selection, or span extraction. Provide a step-by-step plan "\n            "to solve the question based on the extracted information."\n        )\n        question_analysis = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Perform the reasoning or calculation\n        reasoning_instruction = (\n            f"Based on the following analysis: {question_analysis}, "\n            "perform the necessary reasoning or calculation to arrive at the answer. "\n            "Ensure that all steps are clearly explained and that the final answer is "\n            "accurate and well-supported by the extracted information."\n        )\n        reasoning_result = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 4: Refine the result if necessary\n        refinement_instruction = (\n            "Review the reasoning result and refine it if needed. Ensure that the "\n            "answer is concise, accurate, and directly addresses the question. "\n            "If there are multiple possible interpretations, select the most appropriate one."\n        )\n        refined_result = await self.revise(instruction=refinement_instruction, context=reasoning_result)\n\n        # Step 5: Ensemble decision or final output\n        final_instruction = (\n            "Evaluate the refined result and confirm that it is the best possible "\n            "answer to the question. If there are multiple candidate answers, select "\n            "the most accurate one. Provide the final answer in a clear and structured format."\n        )\n        final_answer = await self.ensemble(instruction=final_instruction, contexts=[refined_result])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract the function name from test cases\n        func_name = await self.generate(\n            instruction="""\n            Extract the function name from the test cases. \n            The function name is the part of the assert statement that comes after the equals sign (=).\n            Return ONLY the function name, nothing else.\n            """,\n            context=self.problem_text\n        )\n\n        # Step 2: Generate the initial Python function\n        initial_code = await self.generate(\n            instruction=f"""\n            Write a Python function named \'{func_name}\' that solves this task.\n            Requirements:\n            1. Include ALL necessary import statements at the top\n            2. Handle edge cases (empty inputs, None, boundaries)\n            3. Return ONLY the executable Python code, no explanations\n            4. Ensure the function signature matches the test cases\n            5. Use proper Python syntax and idioms\n            """,\n            context=self.problem_text\n        )\n\n        # Step 3: Revise the generated code for correctness and completeness\n        revised_code = await self.revise(\n            instruction="""\n            Review the generated code and make any necessary improvements.\n            Ensure:\n            - All edge cases are handled\n            - The function signature matches the test cases\n            - The code is clean, efficient, and Pythonic\n            - All necessary imports are included\n            Return ONLY the corrected Python code, no explanations\n            """,\n            context=initial_code\n        )\n\n        # Step 4: Ensemble decision (optional but recommended for complex problems)\n        final_code = await self.ensemble(\n            instruction="""\n            Evaluate the revised code and decide if it meets all requirements.\n            If there are multiple candidate solutions, choose the best one.\n            Return ONLY the final, corrected Python code\n            """,\n            contexts=[initial_code, revised_code]\n        )\n\n        return final_code\n```', '<think>\n</think>\n\n</thi