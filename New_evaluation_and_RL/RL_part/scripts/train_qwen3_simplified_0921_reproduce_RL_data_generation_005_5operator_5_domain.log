rate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Summarize the reasoning chain to focus on the final answer\n        summary_instruction = (\n            "Condense the reasoning chain into a concise summary that directly answers the question. "\n            "Ensure that the summary includes only the essential information needed to answer the question. "\n            "Avoid unnecessary details."\n        )\n        summarized_answer = await self.summarize(instruction=summary_instruction, context=reasoning_chain)\n\n        # Step 4: Ensemble to decide between multiple candidate answers (if applicable)\n        ensemble_instruction = (\n            "Evaluate the summarized answer and ensure it is accurate and complete. "\n            "If there are multiple candidate answers, select the best one based on the reasoning chain. "\n            "Provide the final answer as a short text span or brief factual response."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[summarized_answer])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Carefully analyze the question and identify all key entities, relationships, and implicit connections. "\n            "List out all entities mentioned in the question and their potential relationships. "\n            "Also, identify any bridge entities that might connect different documents or pieces of information."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze each document for relevant information\n        analysis_instruction = (\n            f"Using the extracted information: {extracted_info}, analyze each document to find relevant details. "\n            "Focus on identifying facts that relate to the question\'s entities and relationships. "\n            "Highlight any direct or indirect connections between the documents."\n        )\n        document_analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Synthesize information across documents\n        synthesis_instruction = (\n            f"Based on the extracted information: {extracted_info} and the document analysis: {document_analysis}, "\n            "synthesize the information to form a coherent reasoning chain. "\n            "Ensure that the reasoning connects the entities and relationships identified in the first step. "\n            "If there are multiple possible interpretations, evaluate them and choose the most plausible one."\n        )\n        synthesized_reasoning = await self.generate(instruction=synthesis_instruction, context=self.problem_text)\n\n        # Step 4: Refine the synthesized reasoning\n        refinement_instruction = (\n            "Critique and refine the synthesized reasoning. Ensure that the reasoning is accurate, comple