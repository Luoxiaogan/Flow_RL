erate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Execute the reasoning plan by generating answers from relevant documents\n        reasoning_instruction = (\n            f"Using the reasoning plan: {reasoning_plan}, "\n            "analyze the provided documents and synthesize the answer. "\n            "Ensure the answer is concise and directly addresses the question. "\n            "If multiple documents are involved, explicitly connect the information "\n            "through shared entities or logical relationships."\n        )\n        candidate_answers = await asyncio.gather(\n            self.generate(instruction=reasoning_instruction, context=self.problem_text),\n            self.generate(instruction=reasoning_instruction, context=self.problem_text)\n        )\n\n        # Step 4: Ensemble the candidate answers to select the best one\n        ensemble_instruction = (\n            "Evaluate the following candidate answers and select the most accurate and complete one. "\n            "If necessary, merge or refine the answers to ensure consistency and correctness."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=candidate_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n       