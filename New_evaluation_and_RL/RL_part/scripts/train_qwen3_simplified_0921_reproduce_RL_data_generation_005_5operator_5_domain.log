ors expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = (\n            "Carefully analyze the passage and extract all numerical values, "\n            "entities, and any other relevant information. Ensure that all "\n            "numbers are associated with their corresponding entities or contexts. "\n            "Present the extracted information in a structured format."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Understand the question and determine the required reasoning\n        question_analysis_instruction = (\n            f"Given the extracted information: {extracted_info}, "\n            "analyze the question to determine what it is asking for. "\n            "Break down the question into its components and identify the type of reasoning required "\n            "(e.g., arithmetic, comparison, counting, span extraction). "\n            "Provide a step-by-step plan to solve the problem."\n        )\n        reasoning_plan = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem based on the reasoning plan\n        solution_instruction = (\n            f"Using the reasoning plan: {reasoning_plan}, "\n            "solve the problem step by step. Ensure that all calculations are accurate "\n            "and that the final answer is clearly stated. If multiple approaches are possible, "\n            "consider them and select the most appropriate one."\n        )\n        solution = await self.generate(instruction=solution_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        refinement_instruction = (\n            "Review the solution and critique it for accuracy, complet