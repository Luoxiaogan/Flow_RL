 (\n            f"Based on the analysis: {problem_analysis}, "\n            "solve the problem step by step. Show all intermediate calculations "\n            "and ensure the final answer is clearly stated. Include units if applicable."\n        )\n        solution = await self.generate(instruction=solving_instruction, context=self.problem_text)\n\n        # Step 4: Verify the solution\n        verification_instruction = (\n            f"Review the solution: {solution}, and verify its correctness. "\n            "Check for any errors in calculations, units, or reasoning. Ensure the "\n            "answer makes sense in the context of the problem."\n        )\n        verified_solution = await self.revise(instruction=verification_instruction, context=solution)\n\n        # Step 5: Ensemble decision to select the best solution\n        ensemble_instruction = (\n            "Compare the original solution and the verified solution. "\n            "Select the best solution based on accuracy, completeness, and clarity."\n        )\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[solution, verified_solution]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract the function name from the test cases\n        func_name = await self.generate(\n            instruction="""\n            Extract the function name from the test cases. \n            The function name is the part of the assert statement that comes after the equals sign.\n            Return ONLY the function name, nothing else.\n            """,\n            context=self.problem_text\n        )\n\n        # Step 2: Generate the initial Python function code\n        initial_code = await self.generate(\n            instruction=f"""\n            Write a Python function named \'{func_name}\' that solves this task.\n            Requirements:\n            1. Include ALL necessary import statements at the top\n            2. Handle edge cases (empty inputs, None, boundaries)\n            3. Return ONLY the executable Python code, no explanations\n            4. Ensure the function signature matches the test cases\n            """,\n            context=self.problem_text\n        )\n\n        # Step 3: Revise the initial code to fix any issues\n        revised_code = await self.revise(\n            instruction="""\n            Review the provided Python code and make any necessary improvements.\n            Ensure:\n            - All edge cases are handled\n            - The function signature matches the test cases\n            - The code is efficient and follows Python best practices\n            - All necessary imports are included\n            Return ONLY the corrected Python code, no explanations\n            """,\n            context=initial_code\n        )\n\n        # Step 4: Ensemble to decide between the initial and revised code\n        final_code = await self.ensemble(\n            instruction="""\n            Evaluate the two versions of the Python code:\n            - The initial code\n            - The revised code\n            Select the best version based on:\n            - Correctness\n            - Efficiency\n            - Completeness\n            Return ONLY the final, best Python code\n            """,\n            contexts=[initial_code, revised_code]\n        )\n\n        return final_code\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract all relevant numerical values and entities\n        extraction_instruction = (\n            "Carefully read the entire passage and extract all numerical values, "\n            "entities, and any other relevant information. Ensure that you capture "\n            "all occurrences of numbers, names, and key details that might be needed "\n            "to answer the question. Organize the extracted information clearly."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the required reasoning\n        analysis_instruction = (\n            f"Given the extracted information: {extracted_info}, "\n            "analyze the question to determine what needs to be calculated, counted, "\n            "or identified. Break down the problem into smaller steps if necessary. "\n            "Ensure that you understand the relationship between the question and the "\n            "extracted information. Provide a step-by-step reasoning process."\n        )\n        reasoning = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem based on the reasoning\n        solve_instruction = (\n            f"Using the reasoning provided: {reasoning}, "\n            "solve the problem step by step. Perform any necessary calculations, "\n            "comparisons, or selections. Ensure that your answer is accurate and "\n            "completely addresses the question. Format your final answer clearly."\n        )\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = (\n            "Review the solution provided and critique it for accuracy, completeness, "\n            "and clarity. Identify any potential errors or ambiguities. Provide "\n            "suggestions for improvement if necessary."\n        )\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Ensemble decision to select the best solution\n        ensemble_instruction = (\n            "Evaluate the original solution and the refined solution. Compare them "\n            "based on accuracy, completeness, and clarity. Select the best solution "\n            "and provide a final answer."\n        )\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[solution, refined_solution]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Carefully analyze the question and identify all key entities, "\n            "relationships, and the type of reasoning required. "\n            "List all entities mentioned in the question and their potential connections. "\n            "Also, determine if the question requires bridging information across documents."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze each document for relevant information\n        analysis_instruction = (\n            "Given the extracted information, analyze each document to find relevant details "\n            "about the entities and relationships mentioned. Focus on identifying facts that "\n            "support the reasoning chain required to answer the question. "\n            "Highlight any contradictions or ambiguities."\n        )\n        document_analysis = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Build reasoning chain\n        reasoning_instruction = (\n            "Using the extracted information and document analysis, construct a clear reasoning chain "\n            "that connects the entities and relationships mentioned in the question. "\n            "Ensure that the chain logically leads to the final answer. "\n            "If multiple reasoning paths exist, evaluate their validity and select the most appropriate one."\n        )\n        reasoning_chain = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 4: Refine the reasoning chain\n        refinement_instruction = (\n            "Critique and refine the reasoning chain to ensure accuracy and completeness. "\n            "Check for any missing steps or logical gaps. Improve clarity and precision where necessary."\n        )\n        refined_chain = await self.revise(instruction=refinement_instruction, context=reasoning_chain)\n\n        # Step 5: Ensemble decision or final answer extraction\n        ensemble_instruction = (\n            "Evaluate the refined reasoning chain and determine the final answer. "\n            "If there are multiple candidate answers, compare them and select the most accurate one. "\n            "Ensure the answer is concise and directly addresses the question."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=[refined_chain, extracted_info])\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\nFirst, I need to deeply understand the core characteristics of this problem class. The HotPotQA benchmark involves multi-hop reasoning across multiple documents, requiring the ability to connect information from different sources, resolve entities, and synthesize facts. The workflow must be robust enough to handle various question types such as bridge questions, comparison questions, and compositional questions.\n\nMy strategy will be to break down the problem into logical steps:\n1. **Extract Key Entities and Relationships:** Use the `Generate` operator to identify entities, relationships, and key facts from the problem text and documents.\n2. **Cross-Document Reasoning:** Use another `Generate` call to synthesize information across documents, focusing on bridging entities or comparing properties.\n3. **Refinement and Validation:** Use the `Revise` operator to critique and refine the synthesized information, ensuring accuracy and completeness.\n4. **Final Answer Synthesis:** Use the `Ensemble` operator to decide on the final answer by evaluating multiple candidate solutions or extracting the most relevant information.\n\nI\'ve chosen the `Generate` operator for the initial steps because it is well-suited for creating new information based on detailed instructions. This approach is superior to hardcoding logic or using simplistic operators because it allows for dynamic instruction construction and adaptability to different problem instances. The `Ensemble` operator is ideal for the final step because it can evaluate and synthesize multiple candidate answers, ensuring robustness and correctness.\n\nI will dynamically construct instructions to incorporate extracted information and guide subsequent operations. Parallel execution will be used where possible to improve efficiency, and detailed instructions will ensure clarity and precision.\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Identify all entities, relationships, and key facts mentioned in the problem. "\n            "Focus on bridging entities and any comparative or compositional elements. "\n            "Provide a structured summary of the extracted information."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Cross-document reasoning\n        reasoning_instruction = (\n            f"Using the following extracted information: {extracted_info}, "\n            "analyze the documents to connect the information across different sources. "\n            "Focus on bridging entities or comparing properties as needed. "\n            "Provide a detailed reasoning chain leading to the final answer."\n        )\n        reasoning_result = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 3: Refine and validate the reasoning\n        refinement_instruction = (\n            "Critique and refine the following reasoning: {reasoning_result}. "\n            "Ensure accuracy, completeness, and logical consistency. "\n            "Correct any errors and provide a polished version of the reasoning."\n        )\n        refined_result = await self.revise(instruction=refinement_instruction.format(reasoning_result=reasoning_result), context=self.problem_text)\n\n        # Step 4: Ensemble decision for final answer\n        ensemble_instruction = (\n            "Evaluate the following reasoning: {refined_result}. "\n            "Select the most accurate and complete answer based on the reasoning. "\n            "If multiple candidates exist, synthesize the best solution."\n        )\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction.format(refined_result=refined_result),\n            contexts=[refined_result]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\nFirst, I need to deeply understand the core characteristics of this problem class. The HotPotQA benchmark involves multi-hop reasoning across multiple documents, requiring the ability to connect information through shared entities, compare properties, and synthesize facts. The workflow must be robust enough to handle various question types, including bridge, comparison, and compositional questions.\n\nMy strategy will be to break down the problem into logical steps:\n1. **Extract Key Entities and Relationships:** Use the `Generate` operator to identify all entities, relationships, and relevant facts from the problem text and documents.\n2. **Analyze Document Relevance:** Use another `Generate` call to determine which documents are most relevant to the question and extract key sentences or paragraphs from them.\n3. **Build Reasoning Chains:** Use the `Generate` operator again to construct a reasoning chain that connects the extracted information across documents.\n4. **Refine and Validate:** Use the `Revise` operator to critique and refine the reasoning chain, ensuring it is accurate and complete.\n5. **Synthesize the Final Answer:** Use the `Ensemble` operator to evaluate multiple candidate answers and select the best one.\n\nI\'ve chosen the `Generate` operator for the initial steps because it is versatile and can handle complex reasoning tasks. This approach is superior to hardcoding specific logic because it allows the model to dynamically adapt to the problem at hand. The `Ensemble` operator is ideal for the final step because it can evaluate and synthesize multiple solutions effectively.\n\nI will ensure that instructions are detailed and comprehensive, incorporating extracted information dynamically. Parallel execution will be used where possible to improve efficiency, and all operators will be called with appropriate parameters to maintain clarity and correctness.\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships\n        extraction_instruction = (\n            "Identify all entities, relationships, and relevant facts from the problem text and documents. "\n            "Focus on connecting information across documents and highlight any shared entities or concepts."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze document relevance and extract key sentences\n        relevance_instruction = (\n            f"Given the extracted information: {extracted_info}, determine which documents are most relevant to the question. "\n            "Extract key sentences or paragraphs from each relevant document that support the reasoning process."\n        )\n        relevant_docs = await self.generate(instruction=relevance_instruction, context=self.problem_text)\n\n        # Step 3: Build reasoning chains\n        reasoning_instruction = (\n            f"Using the extracted information: {extracted_info} and relevant documents: {relevant_docs}, "\n            "construct a reasoning chain that connects the information across documents. "\n            "Ensure the chain is logical and addresses the question directly."\n        )\n        reasoning_chain = await self.generate(instruction=reasoning_instruction, context=self.problem_text)\n\n        # Step 4: Refine and validate the reasoning chain\n        refinement_instruction = (\n            f"Review and critique the reasoning chain: {reasoning_chain}. "\n            "Identify any gaps, inconsistencies, or errors and refine the chain to ensure accuracy and completeness."\n        )\n        refined_chain = await self.revise(instruction=refinement_instruction, context=reasoning_chain)\n\n        # Step 5: Synthesize the final answer\n        synthesis_instruction = (\n            "Evaluate the refined reasoning chain and synthesize the final answer. "\n            "Ensure the answer is concise, accurate, and directly addresses the question."\n        )\n        candidate_answers = [\n            await self.generate(instruction=synthesis_instruction, context=refined_chain),\n            await self.generate(instruction=synthesis_instruction, context=refined_chain)\n        ]\n        final_answer = await self.ensemble(instruction="Select the best candidate answer based on accuracy and relevance.", contexts=candidate_answers)\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        