 def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Extract key entities and relationships from the problem\n        entity_extraction_instruction = (\n            "Identify all entities, relationships, and key facts mentioned in the problem. "\n            "Focus on entities like people, places, organizations, and their connections. "\n            "Provide a structured summary of these elements."\n        )\n        entities = await self.generate(instruction=entity_extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question type and reasoning strategy\n        question_analysis_instruction = (\n            f"Given the extracted entities: {entities}, analyze the type of question being asked. "\n            "Determine if it is a bridge question, comparison question, or compositional question. "\n            "Outline the reasoning steps required to answer the question."\n        )\n        analysis = await self.generate(instruction=question_analysis_instruction, context=self.problem_text)\n\n        # Step 3: Retrieve relevant documents and extract supporting facts\n        document_retrieval_instruction = (\n            f"Based on the analysis: {analysis}, identify which documents are most relevant to answering the question. "\n            "Extract key sentences or phrases from these documents that support the reasoning steps outlined."\n        )\n        relevant_documents = await self.generate(instruction=document_retrieval_instruction, context=self.problem_text)\n\n        # Step 4: Synthesize the answer using the extracted information\n        synthesis_instruction = (\n            f"Using the extracted entities: {entities}, the analysis: {analysis}, and the relevant documents: {relevant_documents}, "\n            "construct a step-by-step reasoning chain to arrive at the final answer. "\n            "Ensure the answer is concise and directly addresses the question."\n        )\n        answer = await self.generate(instruction=synthesis_instruction, context=self.problem_text)\n\n        # Step 5: Refine the answer for clarity and correctness\n        refinement_instruction = (\n            "Critique the following answer for clarity, correctness, and completeness. "\n            "Suggest improvements if necessary and provide a refined version."\n        )\n        refined_answer = await self.revise(instruction=refinement_instruction, context=answer)\n\n        # Step 6: Ensemble to select the best answer\n        ensemble_instruction = (\n            "Evaluate the following candidate answers and select the best one based on clarity, correctness, and relevance to the question."\n        )\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[answer, refined_answer]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction constr