ract all relevant numerical values and entities\n        extraction_instruction = (\n            "Carefully read the entire passage and extract all numerical values, "\n            "entities, and key facts. Include any dates, percentages, counts, or other "\n            "quantitative information. Ensure no relevant data is missed."\n        )\n        extracted_info = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Analyze the question and determine the required reasoning\n        analysis_instruction = (\n            f"Based on the extracted information: {extracted_info}, "\n            "analyze the question and determine what needs to be calculated or identified. "\n            "Break down the problem into logical steps. If the question involves arithmetic, "\n            "specify the operations needed. If it requires comparison, identify the entities "\n            "and their corresponding values. Ensure the reasoning is thorough and precise."\n        )\n        reasoning_steps = await self.generate(instruction=analysis_instruction, context=self.problem_text)\n\n        # Step 3: Solve the problem using the reasoning\n        solve_instruction = (\n            f"Using the reasoning steps: {reasoning_steps}, "\n            "perform the necessary calculations or logical deductions to arrive at the answer. "\n            "Ensure the solution is accurate and directly addresses the question. "\n            "If multiple approaches are possible, consider them and select the most appropriate one."\n        )\n        solution = await self.generate(instruction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = (\n            "Review the solution and critique it for accuracy, completeness, and clarity. "\n            "Identify any potential errors or ambiguities. Refine the solution if necessary "\n            "to ensure it is robust and