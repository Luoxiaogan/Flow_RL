uction=solve_instruction, context=self.problem_text)\n\n        # Step 4: Critique and refine the solution\n        critique_instruction = (\n            "Review the solution and critique it for accuracy, completeness, and clarity. "\n            "Identify any potential errors or ambiguities and suggest improvements."\n        )\n        refined_solution = await self.revise(instruction=critique_instruction, context=solution)\n\n        # Step 5: Summarize the final answer\n        summarize_instruction = (\n            "Summarize the final solution in a concise manner, highlighting the key steps "\n            "and the final result. Ensure that the summary is clear and directly answers the question."\n        )\n        final_summary = await self.summarize(instruction=summarize_instruction, context=refined_solution)\n\n        # Step 6: Ensemble decision to select the best answer\n        ensemble_instruction = (\n            "Evaluate the final summary and select the best possible answer. "\n            "Ensure that the selected answer is accurate, complete, and directly addresses the question."\n        )\n        final_answer = await self.ensemble(\n            instruction=ensemble_instruction,\n            contexts=[final_summary, refined_solution]\n        )\n\n        return final_answer\n```', '<think>\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving