{
  "version": "1.0",
  "description": "New_Flow_RL Tool Definitions - 借鉴 ToolOrchestra 设计",
  "tools": [
    {
      "name": "generate",
      "type": "function",
      "description": "根据指令和上下文生成文本内容。用于一般性的文本生成任务，如回答问题、撰写内容等。",
      "parameters": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "description": "生成任务的指令，描述需要生成什么内容"
          },
          "context": {
            "type": "string",
            "description": "可选的上下文信息，提供额外背景"
          },
          "model": {
            "type": "string",
            "description": "使用的模型名称",
            "enum": ["qwen-turbo", "qwen-plus", "qwen-max"],
            "default": "qwen-turbo"
          },
          "temperature": {
            "type": "number",
            "description": "采样温度，控制输出的随机性",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 2.0
          }
        },
        "required": ["instruction"]
      },
      "output": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string",
            "description": "生成的文本内容"
          },
          "model": {
            "type": "string",
            "description": "实际使用的模型"
          },
          "usage": {
            "type": "object",
            "description": "Token使用统计"
          }
        }
      }
    },
    {
      "name": "code_execute",
      "type": "function",
      "description": "在安全沙箱中执行Python代码。支持数学计算、数据处理等任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "要执行的Python代码"
          },
          "timeout": {
            "type": "integer",
            "description": "执行超时时间（秒）",
            "default": 30,
            "minimum": 1,
            "maximum": 300
          },
          "capture_output": {
            "type": "boolean",
            "description": "是否捕获标准输出",
            "default": true
          }
        },
        "required": ["code"]
      },
      "output": {
        "type": "object",
        "properties": {
          "stdout": {
            "type": "string",
            "description": "标准输出内容"
          },
          "stderr": {
            "type": "string",
            "description": "标准错误内容"
          },
          "return_value": {
            "type": "string",
            "description": "代码返回值（如果有）"
          },
          "success": {
            "type": "boolean",
            "description": "执行是否成功"
          },
          "execution_time": {
            "type": "number",
            "description": "执行耗时（秒）"
          }
        }
      }
    },
    {
      "name": "search",
      "type": "function",
      "description": "搜索相关信息。可用于知识检索、事实查询等任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "搜索查询内容"
          },
          "search_type": {
            "type": "string",
            "description": "搜索类型",
            "enum": ["web", "knowledge", "document"],
            "default": "web"
          },
          "max_results": {
            "type": "integer",
            "description": "最大返回结果数",
            "default": 5,
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["query"]
      },
      "output": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "content": {"type": "string"},
                "url": {"type": "string"},
                "relevance_score": {"type": "number"}
              }
            },
            "description": "搜索结果列表"
          },
          "total_found": {
            "type": "integer",
            "description": "找到的总结果数"
          }
        }
      }
    },
    {
      "name": "answer",
      "type": "function",
      "description": "生成最终答案。用于综合所有信息后给出结构化的最终回答。",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "原始问题"
          },
          "context": {
            "type": "string",
            "description": "收集到的相关上下文信息"
          },
          "reasoning": {
            "type": "string",
            "description": "推理过程说明"
          },
          "format": {
            "type": "string",
            "description": "答案格式要求",
            "enum": ["text", "number", "json", "code"],
            "default": "text"
          }
        },
        "required": ["question", "context"]
      },
      "output": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "description": "最终答案"
          },
          "confidence": {
            "type": "number",
            "description": "置信度分数 (0-1)",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "explanation": {
            "type": "string",
            "description": "答案解释"
          }
        }
      }
    },
    {
      "name": "math_solve",
      "type": "function",
      "description": "解决数学问题。专门用于数学计算、方程求解、数学推理等任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "problem": {
            "type": "string",
            "description": "数学问题描述"
          },
          "method": {
            "type": "string",
            "description": "求解方法",
            "enum": ["symbolic", "numerical", "step_by_step"],
            "default": "step_by_step"
          },
          "show_steps": {
            "type": "boolean",
            "description": "是否显示解题步骤",
            "default": true
          }
        },
        "required": ["problem"]
      },
      "output": {
        "type": "object",
        "properties": {
          "solution": {
            "type": "string",
            "description": "最终解答"
          },
          "steps": {
            "type": "array",
            "items": {"type": "string"},
            "description": "解题步骤"
          },
          "final_answer": {
            "type": "string",
            "description": "最终数值答案"
          }
        }
      }
    },
    {
      "name": "code_generate",
      "type": "function",
      "description": "生成代码。根据需求描述生成Python代码。",
      "parameters": {
        "type": "object",
        "properties": {
          "task_description": {
            "type": "string",
            "description": "代码任务描述"
          },
          "language": {
            "type": "string",
            "description": "编程语言",
            "enum": ["python", "javascript", "sql"],
            "default": "python"
          },
          "include_tests": {
            "type": "boolean",
            "description": "是否包含测试用例",
            "default": false
          },
          "style": {
            "type": "string",
            "description": "代码风格",
            "enum": ["concise", "detailed", "documented"],
            "default": "concise"
          }
        },
        "required": ["task_description"]
      },
      "output": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "生成的代码"
          },
          "explanation": {
            "type": "string",
            "description": "代码说明"
          },
          "tests": {
            "type": "string",
            "description": "测试用例（如果请求）"
          }
        }
      }
    }
  ],
  "model_registry": {
    "description": "可用模型列表及其能力描述",
    "models": {
      "qwen-turbo": {
        "provider": "dashscope",
        "description": "快速响应的通用模型",
        "capabilities": ["chat", "generate", "answer"],
        "cost_tier": "low"
      },
      "qwen-plus": {
        "provider": "dashscope",
        "description": "平衡性能与成本的模型",
        "capabilities": ["chat", "generate", "answer", "reasoning"],
        "cost_tier": "medium"
      },
      "qwen-max": {
        "provider": "dashscope",
        "description": "最强能力的模型",
        "capabilities": ["chat", "generate", "answer", "reasoning", "code", "math"],
        "cost_tier": "high"
      },
      "local-7b": {
        "provider": "local_vllm",
        "description": "本地7B模型",
        "capabilities": ["chat", "generate"],
        "cost_tier": "free"
      }
    }
  }
}
