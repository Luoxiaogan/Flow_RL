{'data_source': 'math500', 'solution_str': '<think>\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n        self.decompose = operator.Decompose(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n\n        # Step 1: Generate a detailed understanding of the problem\n        understanding_instruction = (\n            "Carefully analyze the provided problem statement and identify all key elements, including: "\n            "geometric figures, angles, relationships, and any given measurements or properties. "\n            "Determine what needs to be solved and what information is provided."\n        )\n        problem_understanding = await self.generate(instruction=understanding_instruction, context=self.problem_text)\n\n        # Step 2: Decompose the problem into subproblems\n        decomposition_instruction = (\n            "Break down the problem into smaller, manageable subproblems. Each subproblem should focus on a specific aspect "\n            "of the problem, such as identifying known angles, calculating unknown angles, or applying geometric theorems. "\n            "Ensure that the subproblems are logically connected and can be solved sequentially."\n        )\n        decomposition = await self.decompose(instruction=decomposition_instruction, context=problem_understanding)\n\n        # Step 3: Solve each subproblem in parallel\n        # Extract subproblem descriptions for dynamic instruction construction\n        subproblem_descriptions = [subproblem["description"] for subproblem in decomposition]\n        dependencies = [subproblem["dependencies"] for subproblem in decomposition]\n\n        # Prepare detailed instructions for each subproblem\n        subproblem_instructions = []\n        for subproblem_id, description in enumerate(subproblem_descriptions):\n            instruction = (\n                f"Solve the following subproblem: {description}. "\n                f"Use the provided problem context and any relevant geometric theorems. "\n                f"Provide the solution in a clear and precise manner, specifying any angles or relationships."\n            )\n            subproblem_instructions.append(instruction)\n\n        # Execute all subproblems in parallel\n        subproblem_solutions = await asyncio.gather(\n            *[self.generate(instruction=inst, context=self.problem_text) for inst in subproblem_instructions]\n        )\n\n        # Step 4: Ensemble the solutions to determine the final answer\n        ensemble_instruction = (\n            "Evaluate the solutions to the subproblems and select the most accurate and complete one. "\n            "Ensure that the final answer correctly addresses the original problem, including all necessary details such as the measure of α in degrees."\n        )\n        final_answer = await self.ensemble(instruction=ensemble_instruction, contexts=subproblem_solutions)\n\n        return final_answer\n```', 'ground_truth': 'default', 'extra_info': {'raw_data': 100, 'example_indices': [100], 'test_cases': [346, 379, 279, 44, 302], 'data_path': '/home/lg/workflow_tooluse/Flow_RL_luogan/Processed_dataset/hig