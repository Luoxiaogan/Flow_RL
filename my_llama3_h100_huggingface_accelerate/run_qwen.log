neral enough to handle other problems in the GSM8K category.\n\nAnother consideration is that the Ensemble operator could be used if there are multiple approaches, but in this case, it\'s a single calculation.\n\nSo the final code would involve three steps: extract, calculate, sum. Each using Generate with detailed instructions and passing the context appropriately.\n</think>\n\n</think>\n\n</think>\n\n```python\n# --- DO NOT IMPORT HERE ---\nclass Workflow:\n    def __init__(self, config, problem) -> None:\n        # --- DO NOT MODIFY THIS SECTION ---\n        self.config = config\n        self.problem_text = problem\n        self.llm = create(config)\n        \n        self.generate = operator.Generate(self.llm, self.problem_text)\n        self.revise = operator.Revise(self.llm, self.problem_text)\n        self.summarize = operator.Summarize(self.llm, self.problem_text)\n        self.ensemble = operator.Ensemble(self.llm, self.problem_text)\n\n    async def run_workflow(self):\n        """\n        Implement the core problem-solving logic here.\n        Remember: \n        - Use detailed, comprehensive instructions\n        - Dynamic instruction construction is powerful\n        - All operators expect (instruction: str, context: str) except Ensemble which takes contexts: List[str]\n        """\n        import asyncio\n        \n        # Step 1: Extract all numerical values and relationships from the problem\n        extraction_instruction = (\n            "Extract all numerical values and the relationship between Rose\'s and Sophia\'s purchases. "\n            "Identify: Rose\'s onions, Rose\'s potatoes, and the multiplier (how many times Rose\'s purchase is larger than Sophia\'s). "\n            "Provide this information in a structured format."\n        )\n        extraction_result = await self.generate(instruction=extraction_instruction, context=self.problem_text)\n\n        # Step 2: Calculate Sophia\'s onions and potatoes using the extracted values\n        calculation_instruction = (\n            "Given the extracted values: Rose\'s onions = {rose_onions}, Rose\'s potatoes = {rose_potatoes}, "\n            "and the multiplier = {multiplier}, calculate Sophia\'s onions and potatoes. "\n            "Sophia\'s onions = Rose\'s onions / multiplier, Sophia\'s potatoes = Rose\'s potatoes / multiplier. "\n            "Provide the calculated values in a structured format."\n        )\n        # Dynamically construct the instruction with extracted values\n        dynamic_instruction = calculation_instruction.format(\n            rose_onions=extraction_result["rose_onions"],\n            rose_potatoes=extraction_result["rose_potatoes"],\n            multiplier=extraction_result["multiplier"]\n        )\n        calculation_result = await self.generate(instruction=dynamic_instruction, context=extraction_result)\n\n        # Step 3: Sum Sophia\'s onions and potatoes to get the total\n        sum_instruction = (\n            "Sum Sophia\'s onions and potatoes from the calculation result. "\n            "Sophia\'s total = Sophia\'s onions + Sophia\'s potatoes. "\n            "Provide the final answer as a numerical value."\n        )\n        total_result = await self.generate(instruction=sum_instruction, context=calculation_result)\n\n        # Final step: Verify the answer makes sense in context\n        verification_instruction = (\n            "Verify that the calculated answer is logical and consistent with the problem\'s context. "\n            "Ensure that Sophia\'s total is a positive number and that the calculations align with the given relationships."\n        )\n        final_result = await self.revise(instruction=verification_instruction, context=total_result)\n\n        return final_result\n```']



