# Dockerfile for Reward Service

FROM python:3.10-slim

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements.txt /app/

# 安装 Python 依赖
RUN pip install --upgrade pip && \
    pip install fastapi uvicorn pydantic openai pyyaml httpx

# 复制项目代码
COPY src/ /app/src/
COPY services/reward_server/ /app/services/reward_server/
COPY config/ /app/config/

# 设置 PYTHONPATH
ENV PYTHONPATH=/app:$PYTHONPATH

# 暴露端口
EXPOSE 7788

# 启动命令
CMD ["python", "-m", "services.reward_server.server", "--host", "0.0.0.0", "--port", "7788"]
